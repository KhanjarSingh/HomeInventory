# ===================================================
# HOME INVENTORY SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets
JWT_SECRET=your_jwt_access_secret_min_32_characters_long!
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_long!
COOKIE_SECRET=your_cookie_secret_min_32_characters_long!

# Cloudinary Configuration (Server-Side Only - Rotate before production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (Public)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
